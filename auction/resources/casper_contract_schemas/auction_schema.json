      "name": "EndNotInFuture",
      "description": "The end is not in the future.",
      "discriminant": 2
    },
    {
      "name": "NftNotReceived",
      "description": "The NFT contract did not hand the NFT over to the auction.",
      "discriminant": 4
    },
