      "name": "NothingToWithdraw",
      "description": "The caller has no outbid stake to take back in this auction.",
      "discriminant": 10
    },
    {
      "name": "ZeroMinBid",
      "description": "The minimum bid is zero.",
      "discriminant": 1
    }
  ],
  "entry_points": [
    {
      "name": "create_auction",
      "description": "Puts the NFT `token_id` of the CEP-95 contract `nft` up for auction, with bids from `min_bid` motes until `end`, in milliseconds since the Unix epoch. The NFT is pulled from the caller, who must have approved this contract for it. The caller is the seller. The id of the auction is the value `auctions_count` returned before the call; the `AuctionCreated` event carries it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "nft",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "token_id",
          "description": null,
          "ty": "U256",
          "optional": false
        },
        {
          "name": "min_bid",
          "description": null,
          "ty": "U512",
          "optional": false
        },
        {
          "name": "end",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "bid",
      "description": "Bids the CSPR attached to the call. The bid must be at least the minimum bid and beat the highest bid by `MIN_STEP_PERCENT` (`min_next_bid` says how much that is). The bid it beats becomes the stake of its bidder, who takes it back with `withdraw`. A bid less than `EXTENSION` before the end moves the end to `EXTENSION` after the bid.",
      "is_mutable": true,
      "is_payable": true,
      "arguments": [
        {
          "name": "auction_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "__cargo_purse",
          "description": null,
          "ty": "URef",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "withdraw",
      "description": "Sends the caller every outbid bid of theirs in the auction. Allowed at any time.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "auction_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "settle",
      "description": "Ends the auction once its end has passed: the NFT goes to the highest bidder and the highest bid to the seller, or the NFT back to the seller if nobody bid. Anyone may call it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "auction_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "auction",
      "description": "Returns the auction with the given id.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "auction_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Lot",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "min_next_bid",
      "description": "Returns the lowest bid the auction accepts now, in motes.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "auction_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "U512",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "auctions_count",
      "description": "Returns the number of auctions created. Ids run from `0` to `count - 1`.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [],
      "return_ty": "U64",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "auctions_of_seller",
      "description": "Returns the ids of the auctions `seller` created.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "seller",
          "description": null,
          "ty": "Key",
          "optional": false
        }
      ],
      "return_ty": {
        "List": "U64"
      },
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "auctions_of_bidder",
      "description": "Returns the ids of the auctions `bidder` bid in.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "bidder",
