          "ty": "Key",
          "optional": false
        }
      ],
      "return_ty": {
        "List": "U64"
      },
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "withdrawable",
      "description": "Returns the outbid CSPR `bidder` can take back from the auction, in motes.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "auction_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
