  "entry_points": [
    {
      "name": "make_offer",
      "description": "Makes an offer with the caller as the maker: `give_amount` of `give_token` for `want_amount` of `want_token`. Pulls `give_amount` from the caller, who must have approved this contract for at least that amount. The id of the offer is the value `offers_count` returned before the call; the `OfferMade` event carries it. With `taker` set, only that account may take the offer; with `None`, anyone may, and the offer is listed among the open public offers. `expiry` is in milliseconds since the Unix epoch and must be in the future.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "give_token",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "give_amount",
          "description": null,
          "ty": "U256",
          "optional": false
        },
        {
          "name": "want_token",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "want_amount",
          "description": null,
          "ty": "U256",
          "optional": false
        },
        {
          "name": "taker",
          "description": null,
          "ty": {
            "Option": "Key"
          },
          "optional": false
        },
        {
          "name": "expiry",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "take",
      "description": "Takes an offer: moves `want_amount` of `want_token` from the caller to the maker, with the allowance the caller gave this contract, and sends the held `give_amount` of `give_token` to the caller. Both legs happen in this one transaction, or neither does. A maker taking its own offer only gets its tokens back. Only the named taker may take an offer made for one; anyone may take a public offer. An offer can be taken only before its expiry.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "offer_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "cancel",
      "description": "Cancels an offer and sends the held tokens back to the maker. Only the maker may call it, at any time until the offer is taken, after its expiry too.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "offer_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "offer",
      "description": "Returns the offer with the given id.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "offer_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Offer",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "offers_count",
      "description": "Returns the number of offers made. Ids run from `0` to `count - 1`.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [],
