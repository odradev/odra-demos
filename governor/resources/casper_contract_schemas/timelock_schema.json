  "entry_points": [
    {
      "name": "schedule",
      "description": "Proposes a call of `entry_point` of `target` with `args` (serialized `RuntimeArgs`), executable `delay` milliseconds from now. `delay` must be at least the minimum delay. The id of the operation is the value `operations_count` returned before the call; the `OperationScheduled` event carries it. Needs the proposer role.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "target",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "entry_point",
          "description": null,
          "ty": "String",
          "optional": false
        },
        {
          "name": "args",
          "description": null,
          "ty": {
            "List": "U8"
          },
          "optional": false
        },
        {
          "name": "delay",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "execute",
      "description": "Makes the call of an operation whose delay has passed. Needs the executor role. If the call fails, the whole transaction fails and the operation stays ready to execute.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "operation_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "cancel",
      "description": "Cancels an operation that has not been executed. Needs the canceller role, or the caller must be the proposer of the operation.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "operation_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "update_delay",
      "description": "Changes the minimum delay. Only the timelock itself may call it, through an operation.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "new_delay",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
