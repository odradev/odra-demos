  "entry_points": [
    {
      "name": "propose",
      "description": "Proposes to set the fee to `fee_bps` basis points. Voting starts at once. The caller must hold at least the proposal threshold. The id of the proposal is the value `proposals_count` returned before the call; the `ProposalCreated` event carries it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "fee_bps",
          "description": null,
          "ty": "U32",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "vote",
      "description": "Votes for (`support`) or against a proposal with `amount` tokens, which the governor takes with `transfer_from`: approve it first. The tokens stay locked until voting ends. A voter may add tokens to their vote, on the side they chose first.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "proposal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "support",
          "description": null,
          "ty": "Bool",
          "optional": false
        },
        {
          "name": "amount",
          "description": null,
          "ty": "U256",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "withdraw",
      "description": "Gives the caller back the tokens they deposited on a proposal. Allowed once voting has ended, whatever the result.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "proposal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "queue",
      "description": "Hands a passed proposal to the timelock: schedules `set_fee` on the fee contract with the timelock's minimum delay. Anyone may call it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "proposal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "execute",
      "description": "Has the timelock run a queued proposal once its delay has passed: the fee is set. Anyone may call it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "proposal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "proposal",
      "description": "Returns the proposal with the given id.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "proposal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Proposal",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "state",
      "description": "Returns where the proposal stands now.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "proposal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "ProposalState",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "proposals_count",
      "description": "Returns the number of proposals. Ids run from `0` to `count - 1`.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [],
      "return_ty": "U64",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "ballot",
      "description": "Returns what `voter` deposited on a proposal, if anything.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "proposal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "voter",
          "description": null,
          "ty": "Key",
          "optional": false
        }
      ],
      "return_ty": {
        "Option": "Ballot"
      },
      "is_contract_context": true,
      "access": "public"
    }
  ],
