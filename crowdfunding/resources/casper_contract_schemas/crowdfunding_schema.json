  "errors": [
    {
      "name": "AlreadyClaimed",
      "description": "The creator has claimed the pledges already.",
      "discriminant": 10
    },
    {
      "name": "CampaignEnded",
      "description": "The deadline has passed: the campaign takes no more pledges.",
      "discriminant": 6
    },
    {
      "name": "CampaignNotEnded",
      "description": "The deadline has not come yet.",
      "discriminant": 7
