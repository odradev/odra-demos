      "description": "The deadline is not in the future.",
      "discriminant": 2
    },
    {
      "name": "GoalNotReached",
      "description": "The pledges did not reach the goal: the creator cannot claim them.",
      "discriminant": 9
    },
    {
      "name": "GoalReached",
      "description": "The pledges reached the goal: they belong to the creator and cannot be taken back.",
      "discriminant": 11
    },
    {
      "name": "InvalidTitle",
      "description": "The title is empty or longer than `MAX_TITLE_LENGTH` characters.",
      "discriminant": 3
    },
    {
      "name": "NotCreator",
      "description": "Only the creator of the campaign may do this.",
      "discriminant": 8
    },
    {
      "name": "NothingToRefund",
      "description": "The caller has no pledge to take back in this campaign.",
      "discriminant": 12
    },
    {
      "name": "ZeroAmount",
      "description": "The amount to pledge is zero.",
      "discriminant": 5
    },
    {
      "name": "ZeroGoal",
      "description": "The goal is zero.",
      "discriminant": 1
    }
  ],
  "entry_points": [
    {
      "name": "create_campaign",
      "description": "Creates a campaign that collects `token` towards `goal` until `deadline`, in milliseconds since the Unix epoch. The caller is its creator. Its id is the value `campaigns_count` returned before the call; the `CampaignCreated` event carries it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "token",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "title",
          "description": null,
          "ty": "String",
          "optional": false
        },
        {
          "name": "goal",
          "description": null,
          "ty": "U256",
          "optional": false
        },
        {
          "name": "deadline",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "pledge",
      "description": "Pledges `amount` of the campaign's token, pulling it from the caller, who must have approved this contract for at least that amount. Allowed until the deadline, also once the goal is reached; a backer may pledge more than once.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "campaign_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "amount",
          "description": null,
          "ty": "U256",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "claim",
      "description": "Sends every pledge to the creator, once the deadline has passed with the goal reached. Only the creator may call it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "campaign_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "refund",
      "description": "Gives the caller their pledge back, once the deadline has passed with the goal missed.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "campaign_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "campaign",
      "description": "Returns the campaign with the given id.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "campaign_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Campaign",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "campaigns_count",
      "description": "Returns the number of campaigns created. Ids run from `0` to `count - 1`.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [],
      "return_ty": "U64",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "campaigns_of_creator",
