  "entry_points": [
    {
      "name": "create_sale",
      "description": "Creates a sale and pulls `cap` of `token` from the caller, who must have approved this contract for at least that amount. `price` is the price of one whole token in motes; `cap` and `per_wallet` are in the token's smallest unit. Buying is open from block time `start` until `end` (milliseconds, `start` may be in the past). `allowlist_root` is the Merkle root of the addresses that may buy (see `crate::merkle`), or empty for a sale open to everyone. The id of the sale is the value `sales_count` returned before the call; the `SaleCreated` event carries it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "token",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "price",
          "description": null,
          "ty": "U512",
          "optional": false
        },
        {
          "name": "cap",
          "description": null,
          "ty": "U256",
          "optional": false
        },
        {
          "name": "per_wallet",
          "description": null,
          "ty": "U256",
          "optional": false
        },
        {
          "name": "start",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "end",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "allowlist_root",
          "description": null,
          "ty": {
            "List": "U8"
          },
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "buy",
      "description": "Buys tokens of sale `sale_id` with the CSPR attached to the call and sends them to the caller. The CSPR buys `attached × 10^decimals / price` of the smallest unit, which must come out whole: the call reverts rather than keep CSPR that buys nothing. `proof` shows that the caller is on the allowlist: the nodes one after another, 32 bytes each. A sale without an allowlist ignores it.",
      "is_mutable": true,
      "is_payable": true,
      "arguments": [
        {
          "name": "sale_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "proof",
          "description": null,
          "ty": {
            "List": "U8"
          },
          "optional": false
        },
        {
          "name": "__cargo_purse",
          "description": null,
          "ty": "URef",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "withdraw_proceeds",
      "description": "Sends the CSPR paid so far and not yet taken out to the creator. At any time, also while the sale runs. Only the creator may call it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "sale_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "withdraw_unsold",
      "description": "Sends the tokens left unsold back to the creator, once the sale has ended. Only the creator may call it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "sale_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "sale",
      "description": "Returns the sale with the given id.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "sale_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Sale",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "sales_count",
      "description": "Returns the number of sales created. Ids run from `0` to `count - 1`.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [],
      "return_ty": "U64",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "sales_of_creator",
      "description": "Returns the ids of the sales `creator` created, oldest first.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "creator",
          "description": null,
          "ty": "Key",
          "optional": false
        }
      ],
      "return_ty": {
        "List": "U64"
      },
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "bought_by",
      "description": "Returns what `buyer` has bought from sale `sale_id`, in the smallest unit of the token.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "sale_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "buyer",
          "description": null,
          "ty": "Key",
          "optional": false
        }
      ],
      "return_ty": "U256",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "quote",
      "description": "Returns what `paid` motes buy from sale `sale_id`, in the smallest unit of the token. Reverts as `buy` would if the amount is not whole or is more than is left; ignores the window, the wallet limit and the allowlist.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "sale_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "paid",
          "description": null,
          "ty": "U512",
          "optional": false
        }
      ],
      "return_ty": "U256",
      "is_contract_context": true,
      "access": "public"
    }
  ],
