  "entry_points": [
    {
      "name": "register_schema",
      "description": "Registers a schema with the caller as its issuer. Its id is the value `schemas_count` returned before the call; the `SchemaRegistered` event carries it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "name",
          "description": null,
          "ty": "String",
          "optional": false
        },
        {
          "name": "revocable",
          "description": null,
          "ty": "Bool",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "attest",
      "description": "Attests under `schema_id` about `subject`. Only the issuer of the schema may call it. `expires` is a block time in milliseconds after which the attestation no longer holds, or `None` for never. The new attestation becomes the current one of the schema about the subject, the one `is_valid` checks: attesting again replaces an older statement, for example to renew it. Its id is the value `attestations_count` returned before the call; the `Attested` event carries it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "schema_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "subject",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "data",
          "description": null,
          "ty": "String",
          "optional": false
        },
        {
          "name": "expires",
          "description": null,
          "ty": {
            "Option": "U64"
          },
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "revoke",
      "description": "Revokes an attestation. Only the issuer may call it, and only under a revocable schema.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "attestation_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "is_valid",
      "description": "Whether the current attestation of `schema_id` about `subject` holds: it exists, it is not revoked and it has not expired. False for a schema that does not exist. Meant to be called by other contracts.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "schema_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "subject",
          "description": null,
          "ty": "Key",
          "optional": false
        }
      ],
      "return_ty": "Bool",
      "is_contract_context": true,
      "access": "public"
    },
