  "entry_points": [
    {
      "name": "create_schedule",
      "description": "Creates a schedule and pulls `amount` of `token` from the caller, who must have approved this contract for at least that amount. The id of the schedule is the value `schedules_count` returned before the call; the `ScheduleCreated` event carries it. Nothing is vested before `cliff`. Between `cliff` and `end` the vested amount grows linearly, counted from `start`. From `end` on everything is vested. The times are in milliseconds since the Unix epoch and must satisfy `start <= cliff <= end`, `start < end`.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "beneficiary",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "token",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "amount",
          "description": null,
          "ty": "U256",
          "optional": false
        },
        {
          "name": "start",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "cliff",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "end",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "revocable",
          "description": null,
          "ty": "Bool",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "release",
      "description": "Pays out everything that has vested and was not paid out yet to the beneficiary. Anyone may call it; the tokens always go to the beneficiary.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "schedule_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "revoke",
      "description": "Stops a revocable schedule: the unvested tokens go back to the creator, and what has vested so far stays for the beneficiary to release. Only the creator may call it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "schedule_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "schedule",
      "description": "Returns the schedule with the given id.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "schedule_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Schedule",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "vested",
      "description": "Returns the amount vested so far, including what was already released.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "schedule_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "U256",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "releasable",
      "description": "Returns the amount `release` would pay out now.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "schedule_id",
          "description": null,
