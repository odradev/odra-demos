  "errors": [
    {
      "name": "AlreadyClaimed",
      "description": "The recipient has already claimed from this drop.",
      "discriminant": 7
    },
    {
      "name": "ClaimsClosed",
      "description": "The deadline of the drop has passed: nothing more can be claimed.",
      "discriminant": 6
    },
    {
      "name": "DeadlineInPast",
      "description": "The deadline has already passed.",
      "discriminant": 4
