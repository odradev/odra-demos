      "discriminant": 3
    },
    {
      "name": "NoDeadline",
      "description": "The drop has no deadline, so nothing can be taken back.",
      "discriminant": 11
    },
    {
      "name": "NoRecipients",
      "description": "The drop has no recipients.",
      "discriminant": 2
    },
    {
      "name": "NotCreator",
      "description": "Only the creator of the drop may do this.",
      "discriminant": 10
    },
    {
      "name": "NothingToReclaim",
      "description": "Everything has been claimed or taken back already.",
      "discriminant": 13
    },
    {
      "name": "ZeroAmount",
      "description": "The total of the drop is zero.",
      "discriminant": 1
    }
  ],
  "entry_points": [
    {
      "name": "create_drop",
      "description": "Creates a drop and pulls `total` of `token` from the caller, who must have approved this contract for at least that amount. `root` is the Merkle root of the list (see `crate::merkle`), whose amounts should add up to `total`; `recipients` is the length of the list, kept for display. `deadline` is a block time in milliseconds, or zero for none. The id of the drop is the value `drops_count` returned before the call; the `DropCreated` event carries it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "token",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "root",
          "description": null,
          "ty": {
            "List": "U8"
          },
          "optional": false
        },
        {
          "name": "total",
          "description": null,
          "ty": "U256",
          "optional": false
        },
        {
          "name": "recipients",
          "description": null,
          "ty": "U32",
          "optional": false
        },
        {
          "name": "deadline",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "claim",
      "description": "Pays `amount` of drop `drop_id` to `recipient`, if `proof` shows that the pair is on the list and the recipient has not claimed before. `proof` is the nodes of the proof one after another, 32 bytes each. Anyone may call it; the tokens always go to `recipient`.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "drop_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "recipient",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "amount",
          "description": null,
          "ty": "U256",
          "optional": false
        },
        {
          "name": "proof",
          "description": null,
          "ty": {
            "List": "U8"
          },
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "reclaim",
      "description": "Sends what was not claimed back to the creator, once the deadline has passed. Only the creator may call it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "drop_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "drop",
      "description": "Returns the drop with the given id.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "drop_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Drop",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "drops_count",
      "description": "Returns the number of drops created. Ids run from `0` to `count - 1`.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [],
      "return_ty": "U64",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "is_claimed",
