  "entry_points": [
    {
      "name": "create_stream",
      "description": "Creates a stream and pulls `deposit` of `token` from the caller, who must have approved this contract for at least that amount. The id of the stream is the value `streams_count` returned before the call; the `StreamCreated` event carries it. The deposit accrues to the recipient linearly from `start` to `stop`, both in milliseconds since the Unix epoch, with `start < stop`. A `start` in the past is allowed.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "recipient",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "token",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "deposit",
          "description": null,
          "ty": "U256",
          "optional": false
        },
        {
          "name": "start",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "stop",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "withdraw",
      "description": "Pays `amount` of what has accrued and was not withdrawn yet to the recipient. Only the recipient may call it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "stream_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "amount",
          "description": null,
          "ty": "U256",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "cancel",
      "description": "Stops the stream: what has accrued and was not withdrawn goes to the recipient, the rest back to the sender. Only the sender may call it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "stream_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "stream",
      "description": "Returns the stream with the given id.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "stream_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Stream",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "balance_of",
      "description": "Returns what `who` would get out of the stream now: for the recipient, what has accrued and was not withdrawn; for the sender, what has not accrued yet; for anyone else, zero.",
      "is_mutable": false,
      "is_payable": false,
