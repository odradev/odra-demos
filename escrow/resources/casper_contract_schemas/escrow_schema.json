      "description": "The arbiter can decide only a deal with a dispute open.",
      "discriminant": 10
    },
    {
      "name": "NotParty",
      "description": "Only the buyer or the seller of the deal may do this.",
      "discriminant": 6
    },
    {
      "name": "NotSeller",
      "description": "Only the seller of the deal may do this.",
      "discriminant": 5
    },
    {
      "name": "ShareTooLarge",
      "description": "The seller's share is more than the deposit.",
      "discriminant": 14
    },
    {
      "name": "ZeroAmount",
      "description": "The amount of a new deal is zero.",
      "discriminant": 1
    }
  ],
  "entry_points": [
    {
      "name": "create_deal",
      "description": "Opens a deal with the caller as the buyer and pulls `amount` of `token` from the caller, who must have approved this contract for at least that amount. The id of the deal is the value `deals_count` returned before the call; the `DealCreated` event carries it. `deadline` is in milliseconds since the Unix epoch and must be in the future. Any account may hold more than one role, the caller included.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "seller",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "arbiter",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "token",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "amount",
          "description": null,
          "ty": "U256",
          "optional": false
        },
        {
          "name": "deadline",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "release",
      "description": "Pays the whole deposit to the seller. Only the buyer may call it, while the deal is open, with or without a dispute.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "deal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "refund",
      "description": "Sends the whole deposit back to the buyer. Only the seller may call it, while the deal is open, with or without a dispute.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "deal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "open_dispute",
      "description": "Hands the deal to the arbiter. Only the buyer or the seller may call it, before the deadline.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "deal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "resolve",
      "description": "Decides a dispute: `seller_share` of the deposit goes to the seller, the rest to the buyer. Zero decides for the buyer, the whole amount for the seller. Only the arbiter may call it, and only while a dispute is open.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "deal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "seller_share",
          "description": null,
          "ty": "U256",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "reclaim",
      "description": "Gives the deposit back to the buyer once the deadline has passed with no dispute open. Only the buyer may call it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "deal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
