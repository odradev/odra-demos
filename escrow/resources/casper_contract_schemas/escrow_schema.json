      "name": "DeadlineNotReached",
      "description": "The buyer can take the deposit back only from the deadline on.",
      "discriminant": 12
    },
    {
      "name": "DeadlinePassed",
      "description": "The deadline has passed: a dispute can no longer be opened.",
      "discriminant": 11
    },
