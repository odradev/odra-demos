  "entry_points": [
    {
      "name": "lock",
      "description": "Locks `amount` of `token` until `unlock_time`, pulling it from the caller, who must have approved this contract for at least that amount. The caller owns the lock. Its id is the value `locks_count` returned before the call; the `Locked` event carries it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "token",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "amount",
          "description": null,
          "ty": "U256",
          "optional": false
        },
        {
          "name": "unlock_time",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "extend",
      "description": "Moves the unlock time of a lock to `new_unlock_time`, which must be later than the current one. Only the owner may call it, also after the lock has expired.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "lock_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "new_unlock_time",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "transfer_ownership",
      "description": "Hands a lock over to `new_owner`, who may then extend, hand over and withdraw it. Only the owner may call it.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "lock_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "new_owner",
          "description": null,
          "ty": "Key",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "withdraw",
      "description": "Sends the tokens of an expired lock to its owner. Only the owner may call it, at or after the unlock time.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "lock_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "get_lock",
      "description": "Returns the lock with the given id.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "lock_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Lock",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "locks_count",
      "description": "Returns the number of locks created. Ids run from `0` to `count - 1`.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [],
      "return_ty": "U64",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "locks_of",
      "description": "Returns the ids of the locks `owner` owns, withdrawn ones included.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
