  "entry_points": [
    {
      "name": "create_split",
      "description": "Creates a split: `payees[i]` receives `shares[i]` parts of every payment. The id of the split is the value `splits_count` returned before the call; the `SplitCreated` event carries it. At most `MAX_PAYEES` payees, each listed once, each with a share above zero.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "payees",
          "description": null,
          "ty": {
            "List": "Key"
          },
          "optional": false
        },
        {
          "name": "shares",
          "description": null,
          "ty": {
            "List": "U64"
          },
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "pay",
      "description": "Pays `amount` of the CEP-18 `token` into a split: the contract pulls it from the caller, who must have approved this contract for at least that amount. Only tokens paid in this way count. A plain transfer to the contract does not say which split it is for, so it belongs to no split and stays in the contract for good.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "split_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "token",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "amount",
          "description": null,
          "ty": "U256",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "withdraw",
      "description": "Sends the caller everything they are due from a split in `token` and have not withdrawn.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "split_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "token",
          "description": null,
          "ty": "Key",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
